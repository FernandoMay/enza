# Configure only with a currently verified official Testnet USDC issuer.
STELLAR_USDC_TESTNET_ISSUER=
STELLAR_MERCHANT_ADDRESS=

# Explicit, verified Testnet Soroban checkout contract (see contracts/deployments/).
STELLAR_CHECKOUT_CONTRACT_ID=
# Server-side operator (contract admin) Testnet key for on-chain order creation.
# This is a server-only secret: never commit it, never send it to the browser.
STELLAR_CHECKOUT_OPERATOR_SECRET=
# Optional Stellar RPC override; Pubnet endpoints are refused at startup.
STELLAR_RPC_URL=
PORT=3000

# Optional: override the local order-store directory (used by automated tests so
# they never write the operator's real demo store). Defaults to ./.data/.
# ENZA_DATA_DIR=
